rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMember(groupId) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
    }

    // Perfil: cualquiera con sesión lo puede leer (se necesita el Yape/Plin de quien cobra); solo el dueño lo escribe.
    match /users/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    match /groups/{groupId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid];
      // Un miembro puede editar; una persona invitada solo puede agregarse a sí misma.
      allow update: if signedIn() && (
        request.auth.uid in resource.data.memberIds
        || (
          exists(/databases/$(database)/documents/invites/$(groupId + '_' + request.auth.token.email.lower()))
          && request.auth.uid in request.resource.data.memberIds
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
          && request.resource.data.ownerId == resource.data.ownerId
        )
      );
    }

    match /invites/{inviteId} {
      allow read: if signedIn() && (
        resource.data.email == request.auth.token.email.lower()
        || request.auth.uid == resource.data.invitedBy
      );
      allow create: if signedIn() && isMember(request.resource.data.groupId);
      allow update: if signedIn() && resource.data.email == request.auth.token.email.lower();
    }

    // Cuentas: solo miembros del grupo. (Simplificación: cualquier miembro puede actualizar
    // estados; para mayor rigor, restringe a quien registró la cuenta la confirmación de pagos.)
    match /bills/{billId} {
      allow read: if signedIn() && isMember(resource.data.groupId);
      allow create: if signedIn()
        && isMember(request.resource.data.groupId)
        && request.resource.data.payerId == request.auth.uid;
      allow update: if signedIn() && isMember(resource.data.groupId);
      allow delete: if signedIn() && resource.data.payerId == request.auth.uid;
    }
  }
}
